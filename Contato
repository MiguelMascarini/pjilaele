<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contato/Suporte</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #cccccc;
        }

        .header {
            position: relative;
        }

        .header img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .logo {
            position: absolute;
            top: 20px;
            right: 40px;
            background-color: #003b82;
            padding: 20px;
        }

        .logo img {
            width: 100px;
            height: 100px;
            display: block;
        }

        .content {
            background-color: #004d99;
            padding: 50px 0;
        }

        .form-box {
            background-color: #4d4d4d;
            border-radius: 10px;
            padding: 40px;
            width: 60%;
            max-width: 600px;
            margin: 0 auto;
            box-shadow: 0 0 10px rgba(0,0,0,0.3);
            border: 2px solid #0066cc;
        }

        .form-title {
            background-color: #f2f2f2;
            color: black;
            padding: 10px;
            border-radius: 5px;
            text-align: center;
            margin-bottom: 30px;
            font-weight: bold;
        }

        .form-box input {
            width: 100%;
            padding: 10px;
            border-radius: 5px;
            border: none;
            margin-bottom: 20px;
            font-size: 16px;
        }

        .form-box button {
            background-color: #66a3d2;
            color: white;
            border: none;
            padding: 10px 30px;
            border-radius: 5px;
            cursor: pointer;
            display: block;
            margin: 0 auto;
            font-size: 16px;
        }

        .form-box button:hover {
            background-color: #4d94c7;
        }
    </style>
</head>
<body>

    <div class="header">
        <img src="https://i.imgur.com/YKScfOs.jpeg" alt="Praia">
        <div class="logo">
            <img src="https://i.imgur.com/ANXWoxk.png" alt="Logo Ekoskê">
        </div>
    </div>

    <div class="content">
        <div class="form-box">
            <div class="form-title">Suporte/Contato</div>
            <form>
                <input type="email" placeholder="Email ------" required>
                <input type="tel" placeholder="Telefone ------" required>
                <button type="submit">Enviar</button>
            </form>
        </div>
    </div>

</body>
</html>
